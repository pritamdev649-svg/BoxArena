################################################################################
# BoxArena — Flutter Mobile App
# Copy to `flutter_app/.env` (loaded via flutter_dotenv) and add to .gitignore.
#
# ⚠️  READ THIS FIRST
# Nothing here is truly secret. Anything in a Flutter .env, in Dart source, or
# in --dart-define ends up inside the APK/IPA and can be extracted in minutes
# with `apktool`. Put NO gateway secrets, NO Firebase private key, and NO
# Maps *server* key here. Client keys must be locked down by app signature
# instead — see env/README.md.
################################################################################

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://10.0.2.2:5000/api/v1
# 10.0.2.2  = Android emulator's alias for the host machine's localhost
# 127.0.0.1 = iOS simulator
# staging:  https://api-staging.boxarena.in/api/v1
# prod:     https://api.boxarena.in/api/v1
API_TIMEOUT_SECONDS=30
API_RETRY_COUNT=2

# ─── Google Maps (ANDROID key) ────────────────────────────────────────────────
# Restriction: "Android apps" -> package name + SHA-1 fingerprint.
# Register BOTH your debug and release SHA-1s:
#   debug:   keytool -list -v -keystore ~/.android/debug.keystore \
#              -alias androiddebugkey -storepass android -keypass android
#   release: keytool -list -v -keystore release.jks -alias <alias>
# APIs to enable: Maps SDK for Android.
# NOTE: Android additionally requires this in AndroidManifest.xml —
#   <meta-data android:name="com.google.android.geo.API_KEY" android:value="..."/>
# A manifest placeholder in build.gradle is the clean way to inject it per flavor.
GOOGLE_MAPS_ANDROID_API_KEY=

# ─── Google Maps (iOS key) ────────────────────────────────────────────────────
# Restriction: "iOS apps" -> bundle ID (e.g. com.boxarena.app).
# APIs to enable: Maps SDK for iOS.
# Consumed in AppDelegate.swift: GMSServices.provideAPIKey(...)
GOOGLE_MAPS_IOS_API_KEY=

# Geocoding/Places are NOT called from the client — they go through the
# backend's /geo/* proxy so the billable key stays server-side.
ENABLE_MAP_VIEW=true
MAP_DEFAULT_LAT=26.8467
MAP_DEFAULT_LNG=80.9462
MAP_DEFAULT_ZOOM=12

# ─── Razorpay (checkout) ──────────────────────────────────────────────────────
# Only the KEY ID belongs on the client. The secret stays on the server —
# the app never signs anything; it verifies via your backend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_THEME_COLOR=#C6FF3D

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Generated by `flutterfire configure` into lib/firebase_options.dart and the
# google-services.json / GoogleService-Info.plist files. These are NOT secret
# (they identify the project, they don't authorise it) but still gitignore the
# plist/json to avoid mixing prod and dev projects.
FIREBASE_PROJECT_ID=
FCM_VAPID_KEY=                            # only if you build Flutter Web

# ─── Deep links ───────────────────────────────────────────────────────────────
# Powers WhatsApp team invites: https://boxarena.in/join/<token>
DEEP_LINK_HOST=boxarena.in
DEEP_LINK_SCHEME=boxarena
UNIVERSAL_LINK_PREFIX=https://boxarena.in

# ─── Feature flags ────────────────────────────────────────────────────────────
ENABLE_PAID_CHALLENGES=false              # server is authoritative; this just hides UI
ENABLE_MOCK_PAYMENTS=true
SHOW_DEV_BANNER=true

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
ENV_NAME=development

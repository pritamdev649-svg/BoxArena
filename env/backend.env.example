################################################################################
# BoxArena — Node.js / Express Backend
# Copy to `backend/.env` and fill in. NEVER commit the filled version.
# Values marked [SECRET] must never appear in any client bundle or APK.
################################################################################

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | staging | production
PORT=5000
API_VERSION=v1
TZ=UTC                                    # Always UTC on the server. Convert at the edges.
LOG_LEVEL=debug                           # debug | info | warn | error

# Public origin of this API, used to build webhook + deep-link URLs
API_BASE_URL=http://localhost:5000

# Comma-separated. In production list exact origins — never `*`, because
# credentialed CORS with a wildcard is rejected by browsers anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# IMPORTANT: transactions require a REPLICA SET. A standalone mongod silently
# ignores sessions and your wallet logic loses atomicity (edge case 98).
# Local dev:  mongod --replSet rs0  then  rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/boxarena?replicaSet=rs0            # [SECRET]
# Atlas:    mongodb+srv://user:pass@cluster.mongodb.net/boxarena?retryWrites=true&w=majority
MONGODB_DB_NAME=boxarena
MONGODB_MAX_POOL_SIZE=20

# ─── Redis (rate limiting, slot-hold locks, job queue) ────────────────────────
REDIS_URL=redis://127.0.0.1:6379                                        # [SECRET]

# ─── JWT / Sessions ───────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48                      # [SECRET]
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_ACCESS                      # [SECRET]
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=boxarena

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=CHANGE_ME_openssl_rand_base64_32                             # [SECRET]
# Dev only: skips the SMS provider and accepts OTP_DEV_CODE for any number.
# Server MUST refuse to boot if this is true while NODE_ENV=production.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# ─── SMS provider (pick ONE) ──────────────────────────────────────────────────
SMS_PROVIDER=msg91                        # msg91 | twilio | mock
# MSG91 (best India deliverability + cheapest for OTP)
MSG91_AUTH_KEY=                                                         # [SECRET]
MSG91_SENDER_ID=BOXARN
MSG91_OTP_TEMPLATE_ID=
# DLT registration is mandatory in India — register your template with TRAI
# before going live or every message is silently dropped.
MSG91_DLT_TE_ID=
# Twilio (fallback / international)
TWILIO_ACCOUNT_SID=                                                     # [SECRET]
TWILIO_AUTH_TOKEN=                                                      # [SECRET]
TWILIO_PHONE_NUMBER=

# ─── Google Maps Platform (SERVER key) ────────────────────────────────────────
# Restriction: "IP addresses" -> your server/NAT egress IPs ONLY.
# APIs to enable: Geocoding, Places, Distance Matrix.
# This key must NEVER be shipped to the app or the browser (edge case 82).
GOOGLE_MAPS_SERVER_API_KEY=                                             # [SECRET]
GEOCODING_CACHE_TTL_SECONDS=2592000       # 30 days; cuts Maps billing hard
GEO_DEFAULT_CITY=Lucknow
GEO_DEFAULT_LAT=26.8467
GEO_DEFAULT_LNG=80.9462
GEO_DEFAULT_RADIUS_KM=10
GEO_MAX_RADIUS_KM=50

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx     # public-ish; the app needs it too
RAZORPAY_KEY_SECRET=                                                    # [SECRET]
# Set this in the Razorpay dashboard when creating the webhook, then paste here.
RAZORPAY_WEBHOOK_SECRET=                                                # [SECRET]
RAZORPAY_WEBHOOK_PATH=/api/v1/webhooks/razorpay
# RazorpayX, for automated payouts. Leave blank in Phase 1 (manual payouts).
RAZORPAYX_ACCOUNT_NUMBER=
ENABLE_AUTO_PAYOUTS=false

# Dev-only fake payment gateway. Must be false in production.
ENABLE_MOCK_PAYMENTS=true

# ─── Firebase Admin (FCM push) ────────────────────────────────────────────────
# From Firebase Console -> Project Settings -> Service Accounts -> Generate key.
# Prefer the base64 form in hosted environments; a raw JSON file on disk is
# fine locally but easy to leak in a Docker image.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=                                                  # [SECRET]
# Paste the full key INCLUDING the BEGIN/END lines, with literal \n escapes,
# wrapped in double quotes.
FIREBASE_PRIVATE_KEY=""                                                 # [SECRET]
# Alternative: base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_BASE64=                                        # [SECRET]

# ─── Object storage (avatars, arena photos, dispute evidence) ─────────────────
STORAGE_PROVIDER=s3                       # s3 | cloudinary | local
AWS_REGION=ap-south-1                     # Mumbai — keep data in-country
AWS_S3_BUCKET=boxarena-uploads
AWS_ACCESS_KEY_ID=                                                      # [SECRET]
AWS_SECRET_ACCESS_KEY=                                                  # [SECRET]
S3_PRESIGNED_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp
# Cloudinary alternative
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=                                                     # [SECRET]
CLOUDINARY_API_SECRET=                                                  # [SECRET]

# ─── Business rules (mirrored into AppConfig; DB wins at runtime) ─────────────
PLATFORM_COMMISSION_PERCENT=10
MIN_ENTRY_FEE_PAISE=0
MAX_ENTRY_FEE_PAISE=500000                # ₹5,000
MIN_WITHDRAWAL_PAISE=10000                # ₹100
MAX_WITHDRAWAL_PER_DAY_PAISE=2500000      # ₹25,000
SLOT_HOLD_DURATION_SECONDS=300
SLOT_HOLD_EXTENDED_SECONDS=900            # once payment is attempted
MIN_BOOKING_LEAD_MINUTES=30
SLOT_MATERIALISATION_DAYS=30
SCORE_CONFIRMATION_WINDOW_MINUTES=1440    # 24h -> auto-accept single submission
MATCH_VOID_AFTER_HOURS=72                 # neither side submitted
CHALLENGE_MATCH_WINDOW_MINUTES=60         # must be accepted N min before start
DISPUTE_SLA_HOURS=48
DEFAULT_ELO_RATING=1200
ELO_K_FACTOR=32
SIGNUP_BONUS_PAISE=0                      # set >0 only with a wagering policy

# ─── Compliance / responsible gaming ──────────────────────────────────────────
# MASTER KILL-SWITCH for all real-money play. Ship with this false until you
# have written legal advice. See docs/compliance.md.
ENABLE_PAID_CHALLENGES=false
# Real-money gaming is restricted/banned in these states. Verify current law —
# this list changes with litigation and is NOT legal advice.
RMG_BLOCKED_STATES=Assam,Odisha,Telangana,Andhra Pradesh,Nagaland,Sikkim
MIN_AGE_FOR_PAID_PLAY=18
TDS_PERCENT=30                            # s.194BA on net winnings
GST_ON_DEPOSIT_PERCENT=28                 # confirm applicability with a CA
REQUIRE_KYC_FOR_WITHDRAWAL=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_OTP_PER_15_MIN=3
RATE_LIMIT_BOOKING_PER_MINUTE=10

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
ENABLE_REQUEST_LOGGING=true
# Comma-separated fields the logger must always redact.
LOG_REDACT_FIELDS=password,otp,code,token,accessToken,refreshToken,authorization,signature,accountNumber,panNumber

# ─── Admin bootstrap (first boot only; remove after use) ──────────────────────
SEED_SUPER_ADMIN_PHONE=+919999999999
SEED_DEMO_DATA=true                       # arenas, courts, slots for local dev

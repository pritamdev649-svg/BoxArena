################################################################################
# BoxArena — Public Website (Next.js App Router, SEO surface)
# Copy to `web/.env.local`
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. Treat every
# NEXT_PUBLIC_ value as public. Everything without the prefix stays server-side
# (Server Components, Route Handlers, Server Actions).
################################################################################

# ─── Public site config ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BoxArena
NEXT_PUBLIC_DEFAULT_CITY=Lucknow

# Browser-visible API base (client components, SWR)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Server-side base — can be an internal DNS name inside your VPC, skipping
# the public load balancer entirely.
API_INTERNAL_BASE_URL=http://localhost:5000/api/v1

# ─── Google Maps (BROWSER key) ────────────────────────────────────────────────
# Restriction: "Websites (HTTP referrers)" ->
#   http://localhost:3000/*  https://boxarena.in/*  https://*.boxarena.in/*
# APIs to enable: Maps JavaScript API, (optionally) Places API for the widget.
# Referrer restrictions are trivially spoofed outside a browser, so ALSO set a
# daily quota cap in the Cloud Console. This key will be visible in page source.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
NEXT_PUBLIC_MAP_DEFAULT_LAT=26.8467
NEXT_PUBLIC_MAP_DEFAULT_LNG=80.9462
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
# Optional Cloud-styled map. Create under Maps Management -> Map styles.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─── SEO ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_OG_IMAGE_URL=https://boxarena.in/og-default.png
# Leaderboard/arena pages are ISR — how often to revalidate, in seconds.
REVALIDATE_SECONDS=300

# ─── Server-only ──────────────────────────────────────────────────────────────
# Lets the site call read-only public endpoints without a user session.
INTERNAL_API_KEY=                                                       # [SECRET]
REVALIDATE_WEBHOOK_SECRET=                                              # [SECRET]

################################################################################
# /partner and /admin route groups
#
# These live in the SAME Next.js app (see technical_spec.md §4.3). Because the
# origin is shared with the public site, the cookie hardening below is not
# optional — it is what replaces the isolation a separate domain would give.
################################################################################

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Admin/partner sessions live in httpOnly cookies, NOT localStorage — an XSS
# with a readable token would be a full treasury compromise.
# openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48                            # [SECRET]
# Path-scoped so public pages cannot read them even on a shared origin.
PARTNER_COOKIE_NAME=boxarena_partner_session
PARTNER_COOKIE_PATH=/partner
ADMIN_COOKIE_NAME=boxarena_admin_session
ADMIN_COOKIE_PATH=/admin
SESSION_MAX_AGE_SECONDS=28800             # 8h — one shift
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
COOKIE_SECURE=false                       # MUST be true in production
COOKIE_SAME_SITE=strict

# ─── Access control ───────────────────────────────────────────────────────────
# Comma-separated CIDRs enforced in middleware.ts for /admin. Empty = no limit.
ADMIN_IP_ALLOWLIST=
REQUIRE_2FA_FOR_ADMIN=true
# Money actions above this need a second super_admin approval.
DUAL_APPROVAL_THRESHOLD_PAISE=1000000     # ₹10,000

# ─── Content Security Policy ──────────────────────────────────────────────────
# Strict CSP with nonces is what makes a shared origin acceptable.
# No unsafe-inline, no unsafe-eval. Maps JS API needs these hosts allowlisted.
CSP_REPORT_ONLY=true                      # flip to false once the report is clean
CSP_REPORT_URI=

# ─── Admin feature flags ──────────────────────────────────────────────────────
ENABLE_WALLET_ADJUSTMENTS=true            # super_admin only; always audit-logged
ENABLE_MANUAL_PAYOUTS=true
ENABLE_CONFIG_EDITOR=true

# ─── Observability ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                                                      # [SECRET]
NEXT_PUBLIC_ENV_NAME=development

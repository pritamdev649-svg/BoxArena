# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3300

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas is always a replica set, so transactions work — that is the whole
# reason the wallet and booking guarantees hold (edge_cases.md §98).
# The database name (/boxarena) MUST be in the path or Mongo uses "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/boxarena?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=20

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Dev-only values. Regenerate for staging/prod: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_at_least_32_characters_long_ok
JWT_REFRESH_SECRET=dev_refresh_secret_at_least_32_characters_different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_PEPPER=dev_pepper_16_chars_min
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Uploads are signed server-side; the api_secret never reaches a client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=boxarena
MAX_UPLOAD_SIZE_MB=5

# ─── Payments ─────────────────────────────────────────────────────────────────
ENABLE_MOCK_PAYMENTS=true
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Business rules ───────────────────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=10
SLOT_HOLD_DURATION_SECONDS=300
MIN_BOOKING_LEAD_MINUTES=30
SCORE_CONFIRMATION_WINDOW_MINUTES=1440
DISPUTE_SLA_HOURS=48

# ─── Compliance ───────────────────────────────────────────────────────────────
# Ship false until legal sign-off (compliance.md §7). On here only for local testing.
ENABLE_PAID_CHALLENGES=true

# ─── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_OTP_PER_15_MIN=20

SEED_SUPER_ADMIN_PHONE=+919999999999
